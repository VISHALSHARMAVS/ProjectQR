NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/projectqr
SESSION_SECRET=local-dev-session-secret-change-before-deploy
OTP_SECRET=local-dev-otp-secret-change-before-deploy
OTP_MODE=mock
UPLOAD_DIR=./uploads

# Production SMS: use OTP_MODE=sms and configure Twilio credentials.
# Set exactly one of TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
